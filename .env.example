# ===================================================
# AI多平台视频下载分析平台 - 环境变量配置
# 位置：项目根目录（与 README.md 同级）
# 使用：复制本文件为 .env 并填入真实配置
#       cp .env.example .env   （Linux/macOS）
#       copy .env.example .env （Windows）
# ===================================================

# -------------------- 必填 --------------------

# DeepSeek API Key（用于 AI 视频总结、思维导图、问答）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# JWT 签名密钥（用于用户登录 Token）
# 生产环境务必替换为强随机字符串，可用：openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-in-production

# -------------------- Stripe 支付（选填）--------------------
# 不配置则 VIP 支付功能不可用，不影响视频下载和 AI 总结
# 获取地址：https://dashboard.stripe.com/apikeys
# 注意：本地开发用 sk_test_ 开头，生产环境用 sk_live_ 开头
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id

# 前端 URL（Stripe 支付完成后的回跳地址）
# 本地开发：http://localhost:5173
# 生产环境：https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# -------------------- Whisper 语音识别（选填）--------------------
# 用于无字幕视频（如抖音、快手）的自动语音转文字
# 首次启动会从 HuggingFace 下载模型（base 约 150MB）
ENABLE_WHISPER=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_ASR_SECONDS=1800

# -------------------- 管理后台（选填）--------------------
# 启动时自动创建管理员账号，访问 /admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
